@using BloodDonation.Web.Models
@model BloodDonation.Web.Models.SessionViewModel

@{
    ViewData["Title"] = "Manage Sessions";

    // Get the existing sessions supplied by the controller.
    var sessions = ViewBag.Sessions as List<DonationSession>;
}

<section class="dashboard-header">
    <div class="dashboard-header-content">
        <div>
            <span class="dashboard-tag">STAFF PORTAL</span>
            <h1>Manage Sessions</h1>
        </div>

        <a asp-controller="Staff"
           asp-action="Dashboard"
           class="btn btn-light">
            Back to Dashboard
        </a>
    </div>
</section>

<section class="dashboard-body">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">@TempData["Message"]</div>
    }

    <div class="dashboard-panel">
        <div class="dashboard-panel-header">
            <h2>Add New Session</h2>
        </div>

        <!--
            Form for creating a new donation session.
            The asp-controller and asp-action tag helpers submit
            the form to the StaffController Sessions POST action.
        -->
        <form method="post"
              asp-controller="Staff"
              asp-action="Sessions"
              style="padding: 25px; display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">

            <div class="form-group">

                <!--
                    asp-for connects this input to SessionViewModel.SessionDate.
                    The Required and DataType attributes on the model
                    generate the client-side validation metadata.
                -->
                <label asp-for="SessionDate">Date</label>

                <input asp-for="SessionDate"
                       type="date"
                       class="form-control" />

                <!-- Displays the validation message for the session date. -->
                <span asp-validation-for="SessionDate"
                      class="validation-message"></span>
            </div>

            <div class="form-group">

                <!-- Connects this input to SessionViewModel.Time. -->
                <label asp-for="Time">Time</label>

                <input asp-for="Time"
                       type="text"
                       class="form-control"
                       placeholder="e.g. 9:00 AM - 12:00 PM" />

                <!-- Displays the required validation message. -->
                <span asp-validation-for="Time"
                      class="validation-message"></span>
            </div>

            <div class="form-group">

                <!-- Connects this input to SessionViewModel.Location. -->
                <label asp-for="Location">Location</label>

                <input asp-for="Location"
                       type="text"
                       class="form-control" />

                <!-- Displays the required validation message. -->
                <span asp-validation-for="Location"
                      class="validation-message"></span>
            </div>

            <div class="form-group">

                <!-- Connects this input to SessionViewModel.Capacity. -->
                <label asp-for="Capacity">Capacity</label>

                <input asp-for="Capacity"
                       type="number"
                       class="form-control" />

                <!--
                    Displays the required/range validation message.
                    Capacity must be between 1 and 300.
                -->
                <span asp-validation-for="Capacity"
                      class="validation-message"></span>
            </div>

            <button type="submit"
                    class="btn btn-primary"
                    style="grid-column: span 2; justify-self: start;">
                Add Session
            </button>

        </form>
    </div>

    <div class="dashboard-panel">
        <div class="dashboard-panel-header">
            <h2>All Sessions</h2>
        </div>

        <table class="dashboard-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Location</th>
                    <th>Capacity</th>
                    <th>Spots Left</th>
                </tr>
            </thead>

            <tbody>

                @if (sessions != null)
                {
                    foreach (var s in sessions)
                    {
                        <tr>
                            <td>@s.SessionDate.ToString("d MMM yyyy")</td>
                            <td>@s.Time</td>
                            <td>@s.Location</td>
                            <td>@s.Capacity</td>
                            <td>@s.SpotsLeft</td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>

</section>

@section Scripts {
    <!--
        Loads jQuery validation and jQuery unobtrusive validation.
        The asp-for tag helpers above generate the validation
        metadata from SessionViewModel.
    -->
    <partial name="_ValidationScriptsPartial" />
}