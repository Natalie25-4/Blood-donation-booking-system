@using BloodDonation.Web.Models
@{
    ViewData["Title"] = "Staff Dashboard";
}

<section class="dashboard-header">
    <div class="dashboard-header-content">
        <div>
            <span class="dashboard-tag">STAFF DASHBOARD</span>
            <h1>Today's Overview</h1>
        </div>
        <a asp-controller="Staff" asp-action="Sessions" class="btn btn-light">Manage Sessions</a>
    </div>
</section>

<section class="dashboard-body">

    <div class="stat-cards">
        @await Html.PartialAsync("_DashboardStatCard", new DashboardStat { Label = "Total Sessions", Value = ViewBag.TodaySessions.ToString(), IconClass = "fa-solid fa-calendar-day" })
        @await Html.PartialAsync("_DashboardStatCard", new DashboardStat { Label = "Total Bookings", Value = ViewBag.TotalBookings.ToString(), IconClass = "fa-solid fa-clipboard-list" })
        @await Html.PartialAsync("_DashboardStatCard", new DashboardStat { Label = "Deferred Donors", Value = ViewBag.FlaggedCount.ToString(), IconClass = "fa-solid fa-triangle-exclamation" })
        @await Html.PartialAsync("_DashboardStatCard", new DashboardStat { Label = "No-Shows", Value = ViewBag.NoShowCount.ToString(), IconClass = "fa-solid fa-user-xmark" })
    </div>

    <div class="dashboard-panel">
        <div class="dashboard-panel-header">
            <h2>Quick Links</h2>
        </div>
        <div style="padding: 25px; display: flex; gap: 15px;">
            <a asp-controller="Staff" asp-action="Bookings" class="btn btn-secondary">View All Bookings</a>
            <a asp-controller="Staff" asp-action="Sessions" class="btn btn-secondary">Manage Sessions</a>
        </div>
    </div>

</section>