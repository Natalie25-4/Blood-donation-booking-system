@{
    ViewData["Title"] = "Login";
}

<section class="auth-section">
  <div style="width:100%;">
    <div class="auth-toggle">
      <a href= "#" class= "toggle-link active" id= "donor-tab">Donor / Staff Login</a>
      <a href= "#" class= "toggle-link" id= "admin-tab">Administrator Login</a>
    </div>

    <div class="auth-card">
      <h1 id="login-heading">Login</h1>

      <form method="post">
        <div class= "form-group">
          <label for= "Email">Email</label>
          <input type= "email" id= "Email" name= "Email" class= "form-control" required />
        </div>

        <div class="form-group">
          <label for ="Password">Password</label>
          <input type ="password" id= "Password" name = "Password" class = "form-control" required />
        </div>

        <div class="form-check">
          <input type = "checkbox" id = "RememberMe" name = "RememberMe" class = "form-check-input" />
          <label for="RememberMe" class ="form-check-label">Remember me</label>
        </div>

        <button type = "submit" class="btn btn-primary">Login</button>
      </form>
    </div>
  </div>
</section>

<script>
  const donorTab = document.getElementById('donor-tab');
  const adminTab = document.getElementById('admin-tab');
  const heading = document.getElementById('login-heading');

  donorTab.addEventListener('click', (e) => {
    e.preventDefault();
    donorTab.classList.add('active');
    adminTab.classList.remove('active');
    heading.textContent = 'Login';
  });

  adminTab.addEventListener('click', (e) => {
    e.preventDefault();
    adminTab.classList.add('active');
    donorTab.classList.remove('active');
    heading.textContent = 'Administrator Login';
  });
</script>