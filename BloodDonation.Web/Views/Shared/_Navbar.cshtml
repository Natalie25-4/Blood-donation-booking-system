@using BloodDonation.Web.Identity
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string ActiveClass(string controller, string action)
    {
        return (currentController == controller && currentAction == action) ? "active" : "";
    }
}

<nav class="site-navbar">
    <div class="site-navbar-container">

        <a asp-controller="Home" asp-action="Index" class="site-navbar-brand">
            Blood Donation
        </a>

        <div class="site-navbar-links">

            <a asp-controller="Home" asp-action="Index"
               class="site-navbar-link @ActiveClass("Home", "Index")">
                Home
            </a>

            <a href="/#how-it-works" class="site-navbar-link">
                How It Works
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                if (User.IsInRole(Roles.Donor))
                {
                    <a asp-controller="Donor" asp-action="Dashboard"
                       class="site-navbar-link @ActiveClass("Donor", "Dashboard")">
                        My Dashboard
                    </a>
                }

                if (User.IsInRole(Roles.Staff))
                {
                    <a asp-controller="Staff" asp-action="Dashboard"
                       class="site-navbar-link @ActiveClass("Staff", "Dashboard")">
                        Staff Dashboard
                    </a>
                }

                if (User.IsInRole(Roles.Coordinator))
                {
                    <a asp-controller="Coordinator" asp-action="Dashboard"
                       class="site-navbar-link @ActiveClass("Coordinator", "Dashboard")">
                        Coordinator
                    </a>
                }

                <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                    <button type="submit" class="site-navbar-button border-0">
                        Logout
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login"
                   class="site-navbar-link @ActiveClass("Account", "Login")">
                    Donor Login
                </a>

                <a asp-controller="Account" asp-action="StaffLogin"
                   class="site-navbar-link @ActiveClass("Account", "StaffLogin")">
                    Staff Login
                </a>

                <a asp-controller="Account" asp-action="Register"
                   class="site-navbar-button @ActiveClass("Account", "Register")">
                    Register
                </a>
            }

        </div>

    </div>
</nav>