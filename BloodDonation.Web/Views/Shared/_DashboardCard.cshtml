@model BloodDonation.Web.Models.DashboardStat

<div class="stat-card">
    <div class="stat-icon">
        <i class="@Model.IconClass"></i>
    </div>
    <div class="stat-info">
        <span class="stat-value">@Model.Value</span>
        <span class="stat-label">@Model.Label</span>
    </div>
</div>